	(text "UART1: GPIO18 RX <- S3 GPIO42; GPIO19 TX -> S3 GPIO47.\nGPIO8 pulled HIGH for download; GPIO9 is BOOT.\nIndependent UART0 service port, same pinout as control.\nBoth modules share 3.3 V and ground."
		(at 20 156 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "2a580987-fcaa-54e4-86e5-81fb42a08136")
	)
	(text "Logging/telemetry only; motor authority remains on S3.\nPacket loss must not delay edge sensing or control.\nKeep antenna beyond board edge and away from chassis metal."
		(at 20 211 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "3d71d153-6e1e-52f5-bcad-3473b4b4e15e")
	)
